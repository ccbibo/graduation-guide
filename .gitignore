# Allowlist: export only reviewed product files.
*
!.gitignore
!README.md
!THIRD_PARTY_NOTICES.md
!FONT_ASSETS.json
!docs/
!docs/product-brief.md
!docs/usage.md
!docs/architecture.md
!docs/development.md
!docs/images/
!docs/images/product-*.png
!static/
!static/index.html
!static/app.html
!static/landing.css
!static/landing.js
!static/demo.css
!static/images/
!static/images/product-chat.png
!static/fonts/
!static/fonts/*.ttf
!static/fonts/*-OFL.txt
!src/
!src/*.py
!src/engine/
!src/engine/*.py
!src/tests/
!src/tests/test_conversation.py
!src/web/
!src/web/*.html
!src/web/*.css
!src/web/*.js
!src/web/fonts/
!src/web/fonts/*.ttf
!src/web/fonts/*-OFL.txt
**/__pycache__/
**/*.pyc
.env*
**/.env*
**/*.pem
**/*.key
**/.runtime/
**/.venv/
**/node_modules/

!index.html
!.nojekyll
